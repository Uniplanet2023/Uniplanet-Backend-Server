{
	"name": "server",
	"version": "1.0.0",
	"description": "Uniplanet BackEnd Server",
	"main": "index.ts",
	"scripts": {
		"lint": "eslint src",
		"lint:staged": "lint-staged",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"start": "NODE_ENV=production ts-node src/index.ts",
		"dev": "NODE_ENV=production nodemon src/index.ts",
		"test": "jest --verbose --forceExit --detectOpenHandles",
		"test:ci": "jest --verbose --forceExit --detectOpenHandles",
		"test:watch": "jest --verbose --watchAll --no-cache --runInBand --detectOpenHandles",
		"tsc:check": "tsc --noEmit"
	},
	"jest": {
		"testEnvironment": "node",
		"preset": "ts-jest",
		"setupFilesAfterEnv": [
			"./src/test_util/setup_files_after_env.ts"
		]
	},
	"author": "Sije Park",
	"license": "ISC",
	"dependencies": {
		"@socket.io/redis-emitter": "5.1.0",
		"@types/bull": "^4.10.0",
		"@uniplanet-lib/common": "^1.0.22",
		"bull": "^4.12.0",
		"cookie-session": "^2.0.0",
		"cors": "2.8.5",
		"crypto-ts": "1.0.2",
		"dotenv-safe": "8.2.0",
		"express": "4.18.2",
		"express-async-errors": "3.1.1",
		"express-validator": "7.0.1",
		"generate-password": "1.7.1",
		"googleapis": "129.0.0",
		"http": "0.0.1-security",
		"ioredis": "5.3.2",
		"jsonwebtoken": "9.0.2",
		"mongoose": "8.0.2",
		"mongoose-update-if-current": "^1.4.0",
		"node-cron": "3.0.3",
		"node-nats-streaming": "^0.3.2",
		"nodemailer": "6.9.9",
		"otp-generator": "4.0.1",
		"redis": "4.6.11",
		"socket.io": "4.7.2"
	},
	"devDependencies": {
		"@types/bcryptjs": "2.4.6",
		"@types/cookie-session": "^2.0.48",
		"@types/dotenv-safe": "8.1.5",
		"@types/express": "4.17.21",
		"@types/jest": "29.5.10",
		"@types/jsonwebtoken": "9.0.5",
		"@types/node": "20.10.1",
		"@types/node-cron": "3.0.11",
		"@types/nodemailer": "6.4.14",
		"@types/otp-generator": "4.0.2",
		"@types/supertest": "2.0.16",
		"@typescript-eslint/eslint-plugin": "6.13.1",
		"@typescript-eslint/parser": "6.13.1",
		"eslint": "8.54.0",
		"eslint-config-airbnb-typescript": "17.1.0",
		"eslint-config-prettier": "9.0.0",
		"eslint-plugin-import": "2.29.0",
		"eslint-plugin-prettier": "5.0.1",
		"jest": "29.7.0",
		"lint-staged": "15.1.0",
		"mongodb-memory-server": "9.1.1",
		"nodemon": "3.0.2",
		"prettier": "3.1.0",
		"supertest": "6.3.3",
		"ts-jest": "29.1.1",
		"ts-node": "10.9.1",
		"ts-node-dev": "^2.0.0",
		"typescript": "5.3.2"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"npm run prettier:fix",
			"npm run lint",
			"git add"
		]
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged && npm run test"
		}
	}
}
