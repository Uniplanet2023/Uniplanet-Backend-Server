{
	"name": "server",
	"version": "1.0.0",
	"description": "Uniplanet BackEnd Server",
	"main": "index.ts",
	"scripts": {
		"lint": "eslint src",
		"lint:staged": "lint-staged",
		"prettier:check": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"start": "NODE_ENV=production nodemon src/index.ts",
		"dev": "NODE_ENV=development nodemon src/index.ts",
		"test": "jest --verbose --forceExit --detectOpenHandles",
		"test:ci": "jest --verbose --forceExit --detectOpenHandles",
		"test:watch": "jest --verbose --watchAll --no-cache --runInBand --detectOpenHandles",
		"tsc:check": "tsc --noEmit"
	},
	"jest": {
		"testEnvironment": "node",
		"preset": "ts-jest",
		"setupFilesAfterEnv": [
			"./src/test-util/setup-files-after-env.ts"
		]
	},
	"author": "Sije Park",
	"license": "ISC",
	"dependencies": {
		"@uniplanet-lib/common": "^1.0.49",
		"cors": "2.8.5",
		"dotenv-safe": "9.0.0",
		"express-async-errors": "3.1.1",
		"mongoose-update-if-current": "1.4.0",
		"morgan": "^1.10.0",
		"nodemon": "^3.1.0",
		"socket.io": "4.7.4"
	},
	"devDependencies": {
		"@types/bcryptjs": "2.4.6",
		"@types/cookie-session": "2.0.48",
		"@types/dotenv-safe": "8.1.5",
		"@types/express": "4.17.21",
		"@types/jest": "29.5.12",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/morgan": "^1.9.9",
		"@types/node": "20.10.1",
		"@types/supertest": "6.0.2",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"eslint": "8.56.0",
		"eslint-config-airbnb-typescript": "17.1.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-import": "2.29.1",
		"eslint-plugin-prettier": "5.1.3",
		"jest": "29.7.0",
		"lint-staged": "15.2.2",
		"mongodb-memory-server": "9.1.6",
		"prettier": "3.2.5",
		"supertest": "6.3.4",
		"ts-jest": "29.1.2",
		"ts-node-dev": "2.0.0",
		"typescript": "5.3.3"
	},
	"lint-staged": {
		"src/**/*.ts": [
			"npm run prettier:fix",
			"npm run lint",
			"git add"
		]
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged && npm run test"
		}
	}
}
