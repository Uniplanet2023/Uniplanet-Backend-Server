{
	// Most ts-node options can be specified here using their programmatic names.
	"ts-node": {
		// It is faster to skip typechecking.
		// Remove if you want ts-node to do typechecking.
		"transpileOnly": true,

		"files": true
	},
	"compilerOptions": {
		"target": "es6",
		"module": "commonjs",
		"rootDir": "./",
		"outDir": "./build",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"sourceMap": true,
		"skipLibCheck": true,
		"strict": true
	},
	"include": [
		"**/*.ts",
		".eslintrc.js",
		"../common/src/events/serializer/get_product_info.ts",
		"../common/src/events/serializer/get_products_info.ts"
	]
}
